# Example only. Never commit real keys.
# A demo teller-window key, if any, must open only the test Safe module on Fuji.

FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
DEMO_SAFE_ADDRESS=0x0000000000000000000000000000000000000000

# ---- MVP variables (TASKS.md 2.1). Leave a value empty to use the default. ----
# local = anvil (no key needed: anvil test accounts are used), fuji = Avalanche Fuji
NETWORK=local
# RPC of the network. On fuji, a provider URL is better than the public node (rate limits). FUJI_RPC_URL above also works.
RPC_URL=
RPC_FALLBACK_URL=
CHAIN_ID=
EXPLORER_URL=https://testnet.snowtrace.io

# Test-network keys, one per role (fuji only). Never real funds, never committed.
DEPLOYER_PK=
OWNER_PK=
GUARDIAN_PK=
PROTOCOL_GUARDIAN_PK=
ATTACKER_PK=
EVIDENCE_PK=
# three keys separated by commas
BOT_PKS=
# T10 sealed list (fuji only): teller-window operator (needs test AVAX), Safe owners (3 keys, sign only), threshold
OPERATOR_PK=
SAFE_OWNER_PKS=
SAFE_THRESHOLD=2

# true: the API serves fixtures/ ; false: real data from the engine
USE_FIXTURES=true
ENGINE_ENABLED=false
POLL_INTERVAL_S=2
# true: the response sends no transaction
DRY_RUN_ACTIONS=true

AWS_REGION=us-east-1
SNS_TOPIC_ARN=
ALERT_WEBHOOK_URL=
EVIDENCE_BUCKET=
BEDROCK_MODEL_ID=
# phase 2 only (replay of the real incident)
ETH_ARCHIVE_RPC_URL=
