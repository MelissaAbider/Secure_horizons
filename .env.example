# Secure Horizons configuration. Copy to .env (git-ignored) and fill in what you need. Never commit .env.
# On the local chain (NETWORK=local) nothing is required: every role uses anvil's public test accounts.
# An empty value falls back to the default described next to it.

# --- Network ----------------------------------------------------------------------------------------------------
# local (anvil) or fuji (Avalanche Fuji testnet)
NETWORK=local
# Fuji RPC. A provider URL (Alchemy, Infura, ...) is more reliable than the public node. RPC_URL overrides it.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
RPC_URL=
# Secondary RPC the monitor switches to after repeated failures
RPC_FALLBACK_URL=
# Derived from NETWORK when empty: 31337 (local), 43113 (fuji)
CHAIN_ID=
EXPLORER_URL=https://testnet.snowtrace.io

# --- Test-network keys (fuji only) -----------------------------------------------------------------------------
# Test funds only. Share them privately, never in git or a chat.
# Relayer: deploys, seeds, mints test tokens, creates Safes, relays the owner's signatures and pays the gas
DEPLOYER_PK=
# Scenario roles: vault owner, our guardian, the lending protocol's guardian, the attacker, the evidence anchor
OWNER_PK=
GUARDIAN_PK=
PROTOCOL_GUARDIAN_PK=
ATTACKER_PK=
EVIDENCE_PK=
# Three normal users, comma-separated
BOT_PKS=
# Teller window: executes sealed operations through the Safe module (topped up by the deployer)
OPERATOR_PK=
# CLI only (make seal): a server-side Safe owner. The dashboard uses the owner's own wallet instead.
SAFE_OWNER_PKS=
SAFE_THRESHOLD=1

# --- Backend ------------------------------------------------------------------------------------------------------
# true: the API serves fixtures/; false: live data (make live sets false)
USE_FIXTURES=true
# true: the monitoring engine runs inside the API (make live sets true)
ENGINE_ENABLED=false
POLL_INTERVAL_S=2
# true: response actions and agent moves are simulated, nothing is sent on-chain
DRY_RUN_ACTIONS=true

# --- Alerts ---------------------------------------------------------------------------------------------------------
# Discord webhook for the fraud summary and the DORA PDF (secret)
ALERT_WEBHOOK_URL=
# Withdraw buttons on the Discord alert (docs/discord-actions.md). The bot token is a secret.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=
# Discord user ids allowed to click, comma-separated; empty: every click is refused
DISCORD_ALLOWED_USER_IDS=

# --- Allocation agent (docs/agent.md) ---------------------------------------------------------------------------
# Claude on Amazon Bedrock, e.g. us.anthropic.claude-opus-5-5. Empty: the deterministic fallback planner.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# AWS credentials come from the standard chain (~/.aws, an instance role, or the variables below).
# Uncomment only when you set them: an empty AWS_ACCESS_KEY_ID makes boto3 fail.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Production (T8, not wired yet) -------------------------------------------------------------------------------
SNS_TOPIC_ARN=
EVIDENCE_BUCKET=
# Ethereum archive RPC, to replay the April 2026 incident on mainnet data (phase 2)
ETH_ARCHIVE_RPC_URL=
